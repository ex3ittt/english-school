# --- База данных -------------------------------------------------------------
# Локально: `npm run db:local` поднимает встроенный Postgres (PGlite) на 5433.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
# Supabase: pooled-адрес (порт 6543) в DATABASE_URL, прямой (5432) в DIRECT_URL.
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
DIRECT_URL=""

# --- Приложение --------------------------------------------------------------
APP_URL="http://localhost:3000"
# Длинная случайная строка: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string"

# --- Хранилище файлов ---------------------------------------------------------
# local — файлы в ./storage (только для разработки), s3 — любое S3-совместимое
# хранилище: Supabase Storage, Cloudflare R2, AWS S3.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Сколько секунд живёт подписанная ссылка на видео/файл.
MEDIA_URL_TTL="900"

# --- Почта (восстановление пароля) --------------------------------------------
# Если SMTP_HOST пуст, ссылка для сброса пароля пишется в лог сервера.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Школа <no-reply@example.com>"

# --- Seed ---------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@school.local"
SEED_ADMIN_PASSWORD="admin12345"
SEED_STUDENT_PASSWORD="student12345"
